# Backend API
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Local generation
OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
KELLEY_ENABLE_OLLAMA=false

# Retrieval
CHROMA_PATH=data/chroma
KELLEY_CHROMA_COLLECTION=kelley_sources
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Curated public Kelley web crawl
KELLEY_WEB_MAX_PAGES=80
KELLEY_WEB_DELAY=0.25
